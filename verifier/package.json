{
  "name": "amora-age-verifier",
  "version": "1.0.0",
  "description": "Self-hosted verifier for zero-knowledge age proofs (zkPassport) used by the AMORA Discord bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node src/main.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@zkpassport/sdk": "0.18.4",
    "@zkpassport/ui": "0.18.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

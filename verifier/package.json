{
  "name": "amora-age-verifier",
  "version": "1.0.0",
  "description": "Self-hosted verifier for zero-knowledge age proofs (Self, formerly OpenPassport) used by the AMORA Discord bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node src/main.js",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@selfxyz/sdk-common": "1.0.1",
    "esbuild": "0.28.2",
    "qrcode-generator": "2.0.4"
  },
  "dependencies": {
    "@selfxyz/core": "1.2.0-beta.1"
  }
}
